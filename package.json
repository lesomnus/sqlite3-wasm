{
  "name": "sqlite3-wasm-go",
  "version": "0.0.1",
  "description": "Run SQLite in a Web Worker for Go programs compiled to WebAssembly",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "src/wasm_exec.js",
    "src/wasm_exec.d.ts"
  ],
  "sideEffects": [
    "./dist/index.es.js",
    "./dist/go-worker.es.js",
    "./src/index.ts",
    "./src/wasm_exec.js",
    "./src/go-worker/runtime.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js"
    },
    "./go-worker": {
      "types": "./dist/go-worker.d.ts",
      "import": "./dist/go-worker.es.js"
    },
    "./wasm_exec.js": "./src/wasm_exec.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --noEmit && npm run check:wasm-exec && vite build",
    "build:examples": "tsx scripts/build-examples.mts",
    "gen:wire": "python3 scripts/gen-wire-vectors.py",
    "pretest": "npm run build:examples && npm run build",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "check:wasm-exec": "tsx scripts/check-wasm-exec.mts",
    "check:downstream": "tsx scripts/check-downstream.mts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@sqlite.org/sqlite-wasm": "3.50.4-build1",
    "@types/node": "^24.10.0",
    "@vitest/browser-playwright": "^4.0.7",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.7",
    "zx": "^8.8.5"
  }
}
